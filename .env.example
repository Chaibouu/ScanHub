# Générer une clé privée (2048 bits)
#openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048

# Extraire la clé publique
#openssl rsa -pubout -in private.pem -out public.pem
RSA_PRIVATE_KEY=""
RSA_PUBLIC_KEY=""

# Redis (rate limiting) — optionnel en dev, recommandé en production
REDIS_URL="redis://localhost:6379"

# Peppers de hachage (OBLIGATOIRES en production)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Changer QR_PEPPER invalide tous les QR déjà enregistrés ; changer API_KEY_PEPPER
#    invalide les clés partenaires, clés de terminaux et codes d'activation.
QR_PEPPER=""
API_KEY_PEPPER=""

# Webhooks : secret de la route planifiée /api/cron/webhooks (nouvelles tentatives d'envoi)
# À appeler chaque minute avec l'en-tête  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Seed (dev uniquement) — si absents, des mots de passe aléatoires sont générés et affichés
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_AGENT_PASSWORD=""
